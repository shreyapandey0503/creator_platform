# Copy to .env and fill in. Never commit .env.

# YouTube Data API v3 key (Google Cloud Console -> APIs & Services -> Credentials).
# Restrict the key to "YouTube Data API v3".
YOUTUBE_API_KEY=

# Optional: GCP project the key belongs to (shown in the UI for reference only).
GCP_PROJECT_ID=

# Daily quota budget we allow ourselves to spend (Google's default is 10000 units/day).
YOUTUBE_DAILY_QUOTA=10000

# SQLite database path, relative to the project root.
DB_PATH=data/creators.db

# ---- SaaS
# Platform service fee charged per creator per campaign (INR), and GST added on invoices.
FEE_PER_CREATOR_INR=499
GST_RATE=0.18
PLATFORM_DB_PATH=data/platform.db
ORGS_DIR=data/orgs

# Postgres instead of the SQLite files above (required on Vercel). Supabase -> Connect -> Transaction pooler.
# Leave empty to use SQLite locally.
DATABASE_URL=
